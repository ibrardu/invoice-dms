# Neon (added automatically when you connect Neon in Vercel)
DATABASE_URL=
# Neon Auth (NEON_AUTH_BASE_URL is set by the Neon integration)
# Vercel Blob (added automatically when you create a private Blob store)
BLOB_READ_WRITE_TOKEN=
# Comma separated emails allowed to use the app (leave empty to allow anyone who signs in)
ALLOWED_EMAILS=
# Reading SVRs and receipts with LlamaParse / LlamaExtract (recommended, free plan, EU region)
#   Sign up at https://cloud.eu.llamaindex.ai (EU keys only work with the EU address), create an API key.
LLAMA_CLOUD_API_KEY=
#   Optional: project id from the LlamaCloud console URL, if your account has several projects
LLAMA_CLOUD_PROJECT_ID=
#   Optional: defaults below
# LLAMA_CLOUD_BASE_URL=https://api.cloud.eu.llamaindex.ai
# LLAMA_CLOUD_TIER=cost_effective
# Fallback when LLAMA_CLOUD_API_KEY is empty: any OpenAI-compatible Llama endpoint
# Llama for reading Site Visit Reports (any OpenAI-compatible endpoint):
#   Meta Llama API: https://api.llama.com/compat/v1  model Llama-4-Maverick-17B-128E-Instruct-FP8
#   Groq:           https://api.groq.com/openai/v1   model llama-3.3-70b-versatile
#   Self-hosted Ollama (must be reachable from the internet): https://your-host/v1  model llama3.1
LLAMA_API_URL=
LLAMA_API_KEY=
LLAMA_MODEL=
NEON_AUTH_COOKIE_SECRET=   # openssl rand -base64 32
ALLOW_SIGNUP=false   # set true temporarily to create a new user
# Optional: model that can read images, for receipt photos (falls back to LLAMA_MODEL)
#   Meta Llama API: Llama-4-Maverick-17B-128E-Instruct-FP8   Groq: meta-llama/llama-4-scout-17b-16e-instruct
LLAMA_VISION_MODEL=
# Email via Brevo (free 300/day): https://app.brevo.com > SMTP & API > API keys; verify the sender under Senders
BREVO_API_KEY=
MAIL_FROM=ibrar@ibrar.eu
MAIL_FROM_NAME=Ibrar Ahmad
# Bank connection via Enable Banking (free restricted mode for your own accounts): https://enablebanking.com
#   Register an app (Production), redirect URL https://<your-domain>/api/bank/callback, link your own account to activate.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
# Deployment mode: internal (your own app, default) or saas (public landing page, open sign-up, one workspace per account)
APP_MODE=internal
NEXT_PUBLIC_PRODUCT_NAME=Feldbuch
