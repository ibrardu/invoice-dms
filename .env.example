# Neon (added automatically when you connect Neon in Vercel)
DATABASE_URL=
# Neon Auth (NEON_AUTH_BASE_URL is set by the Neon integration)
# Vercel Blob (added automatically when you create a private Blob store)
BLOB_READ_WRITE_TOKEN=
# Comma separated emails allowed to use the app (leave empty to allow anyone who signs in)
ALLOWED_EMAILS=
# Llama for reading Site Visit Reports (any OpenAI-compatible endpoint):
#   Meta Llama API: https://api.llama.com/compat/v1  model Llama-4-Maverick-17B-128E-Instruct-FP8
#   Groq:           https://api.groq.com/openai/v1   model llama-3.3-70b-versatile
#   Self-hosted Ollama (must be reachable from the internet): https://your-host/v1  model llama3.1
LLAMA_API_URL=
LLAMA_API_KEY=
LLAMA_MODEL=
NEON_AUTH_COOKIE_SECRET=   # openssl rand -base64 32
ALLOW_SIGNUP=false   # set true temporarily to create a new user
# Optional: model that can read images, for receipt photos (falls back to LLAMA_MODEL)
#   Meta Llama API: Llama-4-Maverick-17B-128E-Instruct-FP8   Groq: meta-llama/llama-4-scout-17b-16e-instruct
LLAMA_VISION_MODEL=
